<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/footballTeamLogos"
    android:layout_width="68dp"
    android:layout_height="40dp"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <FrameLayout
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:background="#09182A">

        <ImageView
            android:id="@+id/footballHomeLogo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="Logo tim pertama"
            android:padding="1dp"
            android:scaleType="fitCenter" />

        <TextView
            android:id="@+id/footballHomeFallback"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="#00F5FF"
            android:textSize="9sp"
            android:textStyle="bold" />
    </FrameLayout>

    <FrameLayout
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginStart="4dp"
        android:background="#09182A">

        <ImageView
            android:id="@+id/footballAwayLogo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="Logo tim kedua"
            android:padding="1dp"
            android:scaleType="fitCenter" />

        <TextView
            android:id="@+id/footballAwayFallback"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="#C084FC"
            android:textSize="9sp"
            android:textStyle="bold" />
    </FrameLayout>

</LinearLayout>
